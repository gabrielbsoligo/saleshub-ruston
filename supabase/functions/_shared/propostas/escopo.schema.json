{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposta-escopo/v1",
  "title": "Escopo da proposta (saída da análise da transcrição, editada pelo closer)",
  "type": "object",
  "required": [
    "schema_version",
    "cliente",
    "escopo",
    "preco"
  ],
  "additionalProperties": false,
  "$defs": {
    "citacao": {
      "type": [
        "string",
        "null"
      ],
      "description": "Trecho literal da transcrição que justifica o item (null se veio do catálogo padrão ou do closer)."
    },
    "item": {
      "type": "object",
      "required": [
        "texto",
        "origem"
      ],
      "additionalProperties": false,
      "properties": {
        "catalogo_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "texto": {
          "type": "string",
          "minLength": 1
        },
        "origem": {
          "enum": [
            "catalogo",
            "ia",
            "closer"
          ]
        },
        "citacao": {
          "$ref": "#/$defs/citacao"
        }
      }
    },
    "valor": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "properties": {
    "schema_version": {
      "enum": [
        "proposta-escopo/v0",
        "proposta-escopo/v1"
      ]
    },
    "catalogo_versao": {
      "type": "string"
    },
    "cliente": {
      "type": "object",
      "required": [
        "empresa",
        "modelo_venda"
      ],
      "additionalProperties": false,
      "properties": {
        "empresa": {
          "type": "string",
          "minLength": 1
        },
        "contato": {
          "type": [
            "string",
            "null"
          ]
        },
        "segmento": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelo_venda": {
          "enum": [
            "inside_sales",
            "pdv",
            "ecommerce"
          ]
        }
      }
    },
    "contexto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "objetivos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "publico": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "concorrentes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "cliente_fornece": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "proximos_passos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "escopo": {
      "type": "object",
      "required": [
        "semanas"
      ],
      "additionalProperties": false,
      "properties": {
        "enfases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semanas": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "id",
              "titulo",
              "itens"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "titulo": {
                "type": "string"
              },
              "itens": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/item"
                }
              }
            }
          },
          "description": "Obrigatório (>= 1) só na Estruturação."
        },
        "overdeliveries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "plano_execucao": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "incluido": {
          "type": "boolean"
        },
        "faixa_midia": {
          "type": [
            "string",
            "null"
          ]
        },
        "itens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "preco": {
      "type": "object",
      "description": "Preço falado pelo closer na reunião. Null = não encontrado na transcrição (vira pendência e placeholder visível).",
      "required": [
        "fonte"
      ],
      "additionalProperties": false,
      "properties": {
        "estruturacao": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "valor_total": {
              "$ref": "#/$defs/valor"
            },
            "parcelas": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "valor_parcela": {
              "$ref": "#/$defs/valor"
            },
            "condicao": {
              "type": [
                "string",
                "null"
              ],
              "description": "Ex.: 'Condição exclusiva junto com a execução, válida até 05/11'"
            }
          }
        },
        "execucao_mensal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "valor": {
              "$ref": "#/$defs/valor"
            },
            "valor_com_social": {
              "$ref": "#/$defs/valor"
            },
            "meses": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "validade": {
          "type": [
            "string",
            "null"
          ],
          "description": "Data até quando a proposta vale, combinada na reunião (dd/mm ou dd/mm/aaaa). Null = [PREENCHER] + pendência. Prazo relativo falado (\"hoje\", \"fim do mês\") é convertido pela data da reunião, com pendência para conferir."
        },
        "fonte": {
          "enum": [
            "transcricao",
            "closer"
          ]
        },
        "citacoes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "oferta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recorrencia": {
              "enum": [
                "unico",
                "mensal"
              ]
            },
            "valor_tabela": {
              "$ref": "#/$defs/valor"
            },
            "desconto_percentual": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 100
            },
            "valor_final": {
              "$ref": "#/$defs/valor"
            },
            "valor_final_calculado": {
              "type": "boolean"
            },
            "parcelas": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "valor_parcela": {
              "$ref": "#/$defs/valor"
            }
          }
        }
      }
    },
    "pendencias": {
      "type": "array",
      "description": "O que a análise não conseguiu extrair e o closer precisa completar antes do envio.",
      "items": {
        "type": "string"
      }
    },
    "oferta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "estruturacao",
            "implementacao",
            "execucao",
            "implementacao_e_execucao"
          ],
          "description": "STEP: estruturacao=SABER, implementacao=TER, execucao=EXECUTAR"
        },
        "origem": {
          "enum": [
            "ia",
            "closer",
            "padrao"
          ]
        },
        "citacao": {
          "$ref": "#/$defs/citacao"
        }
      }
    },
    "entregaveis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "texto",
          "origem"
        ],
        "additionalProperties": false,
        "properties": {
          "produto_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "id do portfólio V4 (catalogo-v1.produtos)"
          },
          "texto": {
            "type": "string",
            "minLength": 1
          },
          "origem": {
            "enum": [
              "ia",
              "closer"
            ]
          },
          "citacao": {
            "$ref": "#/$defs/citacao"
          },
          "recorrencia": {
            "enum": [
              "unico",
              "mensal"
            ]
          },
          "valor": {
            "$ref": "#/$defs/valor"
          }
        }
      }
    },
    "custos_terceiros": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "texto"
        ],
        "additionalProperties": false,
        "properties": {
          "texto": {
            "type": "string",
            "minLength": 1
          },
          "valor": {
            "$ref": "#/$defs/valor"
          },
          "periodicidade": {
            "enum": [
              "mensal",
              "unico",
              null
            ]
          },
          "citacao": {
            "$ref": "#/$defs/citacao"
          }
        }
      }
    },
    "etapa2": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "quando": {
          "type": [
            "string",
            "null"
          ]
        },
        "itens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "valor_mensal": {
          "$ref": "#/$defs/valor"
        },
        "verba_midia": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "canal": {
                "type": "string"
              },
              "valor": {
                "$ref": "#/$defs/valor"
              }
            }
          }
        }
      }
    }
  },
  "description": "v1 (30/10/2026): tipo de oferta; fora da Estruturação o deck é curto (entregaveis, preco.oferta, custos_terceiros, etapa2) e escopo.semanas fica vazio. v0 continua válido (sem oferta = Estruturação)."
}
