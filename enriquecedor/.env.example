# Supabase de AUTENTICAÇÃO — o mesmo projeto do SalesHub (login compartilhado).
# No deploy do Vercel essas variáveis já existem; em dev, copie do .env do SalesHub.
VITE_SUPABASE_URL="https://PROJETO_DO_SALESHUB.supabase.co"
VITE_SUPABASE_ANON_KEY="anon_key_do_saleshub"

# Supabase de DADOS — projeto PRÓPRIO do enriquecedor (criar em supabase.com).
# Enquanto vazio, os dados ficam em modo local (localStorage do navegador).
VITE_ENRIQUECEDOR_SUPABASE_URL=""
VITE_ENRIQUECEDOR_SUPABASE_ANON_KEY=""

# Busca de site por API (motor de enriquecimento). Opcional, mas recomendado
# para achar o site de leads sem e-mail corporativo. Use UMA das opções.
# Brave Search API — grátis 2.000/mês, sem cartão: https://api-dashboard.search.brave.com
BRAVE_API_KEY=""
# Alternativa: Serper (Google) — https://serper.dev  (crédito grátis inicial)
# SERPER_API_KEY=""

# Espaçamento entre buscas em ms. Brave grátis = 1/seg (1100). Em plano pago com
# rate maior, reduza (ex.: 100) para enriquecer mais rápido.
# SEARCH_INTERVAL_MS="1100"

# Anthropic (Claude) — extrair empreendimentos do site/busca + briefing por IA.
# Criar em console.anthropic.com. Fica só no backend, nunca no frontend.
ANTHROPIC_API_KEY=""

# Serper (serper.dev) — Google Meu Negócio (nota/avaliações/categoria) via Places.
SERPER_API_KEY=""

# PageSpeed Insights (Google) — nota real do site (performance/SEO). Funciona SEM
# chave em baixo volume; chave grátis no Google Cloud p/ volume maior (sem billing).
# PAGESPEED_API_KEY=""

# Kommo CRM — Fase 4 (integração real). Deixar vazio por enquanto.
# KOMMO_BASE_URL=""
# KOMMO_ACCESS_TOKEN=""
