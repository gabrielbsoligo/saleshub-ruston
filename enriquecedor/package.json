{
  "name": "sdna-outbound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n site,motor -c blue,green \"vite --port=3001 --host=0.0.0.0\" \"npm:server\"",
    "site": "vite --port=3001 --host=0.0.0.0",
    "server": "node --env-file-if-exists=.env.local --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "setup:motor": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@supabase/supabase-js": "^2.103.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bottleneck": "2.19.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.546.0",
    "p-limit": "7.3.1",
    "p-queue": "9.3.3",
    "p-retry": "8.0.0",
    "papaparse": "^5.4.1",
    "playwright": "^1.61.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
