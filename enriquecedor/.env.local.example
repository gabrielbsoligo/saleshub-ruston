# Copie este arquivo para .env.local e preencha com os VALORES reais.
# O .env.local é gitignorado (NUNCA vai pro GitHub — guarda segredos).

# Busca web (descoberta de site/empreendimentos)
BRAVE_API_KEY=

# Google Meu Negócio (Places) + fallback de busca
SERPER_API_KEY=

# PageSpeed Insights (Google) — nota do site/LPs
PAGESPEED_API_KEY=

# Briefing e extração de empreendimentos (Claude)
ANTHROPIC_API_KEY=

# Organograma + porte + contatos do decisor
DATASTONE_API_TOKEN=

# Contatos dos sócios (telefone/e-mail por CPF)
LEMIT_API_TOKEN=

# Proxy residencial (Decodo) — anúncios do Meta em escala (anti-ban)
PROXY_SERVER=http://gate.decodo.com:7000
PROXY_USERNAME=
PROXY_PASSWORD=

# (Opcional) espaçamento entre buscas em ms — Brave grátis = ~1100
# SEARCH_INTERVAL_MS=1100
